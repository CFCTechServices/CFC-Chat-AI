@page "/reset-password"
@using System.Text.Json
@inject ChatApiClient Api
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="login-page">

    <div class="login-hero">
        <h1>@(isRecoveryMode ? "Set New Password" : "Reset Password")</h1>

        <p>
            @(isRecoveryMode
                ? "Enter your new password below."
                : "Enter your email and we'll send you a reset link.")
        </p>
    </div>

    <div class="login-card">

        @if (checkingLink)
        {
            <p role="status">Checking reset link…</p>
        }
        else if (passwordUpdated)
        {
            <h2>Password updated</h2>
            <p role="status">You can now sign in with your new password.</p>
            <a href="/login">Back to Sign In</a>
        }
        else if (isRecoveryMode)
        {
            <form class="login-form"
                  @onsubmit="SetNewPassword"
                  @onsubmit:preventDefault="true">

                <h2>New Password</h2>

                <label for="new-password">New Password</label>

                <input id="new-password"
                       type="password"
                       placeholder="Enter new password"
                       autocomplete="new-password"
                       required minlength="6" @ref="newPassword" />

                <label for="confirm-password">Confirm Password</label>

                <input id="confirm-password"
                       type="password"
                       placeholder="Confirm new password"
                       autocomplete="new-password"
                       required minlength="6" @ref="confirmPassword" />

                @if (!string.IsNullOrEmpty(error))
                {
                    <div role="alert" style="color: #b91c1c;">
                        @error
                    </div>
                }

                <button type="submit"
                        disabled="@busy">
                    @(busy ? "Updating…" : "Set New Password")
                </button>

            </form>
        }
        else
        {
            <form class="login-form"
                  @onsubmit="RequestResetEmail"
                  @onsubmit:preventDefault="true">

                <h2>Forgot Password</h2>

                <label for="reset-email">Email Address</label>

                <input id="reset-email"
                       type="email"
                       placeholder="Enter your email"
                       autocomplete="email"
                       required @ref="emailInput" />

                @if (!string.IsNullOrEmpty(error))
                {
                    <div role="alert" style="color: #b91c1c;">
                        @error
                    </div>
                }

                <button type="submit" disabled="@busy">
                    @(busy ? "Sending…" : "Send Reset Link")
                </button>

                <p>
                    <a href="/login">Back to Sign In</a>
                </p>

            </form>
        }

        @if (message is not null)
        {
            <p role="status">@message</p>
        }
    </div>
</div>

@code {
    private readonly CancellationTokenSource lifetime = new();
    private ElementReference emailInput, newPassword, confirmPassword;
    private string? error, message;
    private bool checkingLink = true, hasLink, isRecoveryMode, busy, passwordUpdated;
    private const string InvalidLink = "This reset link is invalid or expired. Request a new link.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            hasLink = await JS.InvokeAsync<bool>("cfcAuth.hasRecoveryLink", lifetime.Token);
            if (hasLink)
            {
                var config = await Api.GetAuthConfigAsync(lifetime.Token);
                isRecoveryMode = SupabaseSessionService.IsPublicConfig(config) &&
                    await JS.InvokeAsync<bool>("cfcAuth.prepareRecovery", lifetime.Token, config.SupabaseUrl, config.SupabaseKey);
                if (!isRecoveryMode) error = InvalidLink;
            }
        }
        catch (Exception ex) when (IsRequestFailure(ex)) { error = "Could not verify the reset link. Request a new link and try again."; }
        checkingLink = false;
        if (!lifetime.IsCancellationRequested) StateHasChanged();
    }

    private async Task RequestResetEmail()
    {
        if (busy || checkingLink || isRecoveryMode) return;
        busy = true;
        error = message = null;
        try
        {
            var email = await JS.InvokeAsync<string>("cfcAuth.readEmail", lifetime.Token, emailInput);
            var response = await Api.RequestPasswordResetAsync(new(email), lifetime.Token);
            if (response.Success) message = "If an account exists for this email, check your inbox for a reset link.";
            else error = response.Message;
        }
        catch (Exception ex) when (IsRequestFailure(ex)) { error = "Could not request a reset link. Check your connection and try again."; }
        finally { busy = false; }
    }

    private async Task SetNewPassword()
    {
        if (busy || !isRecoveryMode) return;
        busy = true;
        error = message = null;
        try
        {
            var result = await JS.InvokeAsync<string>("cfcAuth.updatePassword", lifetime.Token, newPassword, confirmPassword);
            if (result == "updated")
            {
                isRecoveryMode = false;
                passwordUpdated = true;
            }
            else if (result == "invalid") { isRecoveryMode = false; error = InvalidLink; }
            else error = result switch
            {
                "short" => "Password must be at least 6 characters.",
                "mismatch" => "Passwords do not match.",
                _ => "Supabase could not update the password. Try a different password or request a new link."
            };
        }
        catch (Exception ex) when (IsRequestFailure(ex)) { error = "Could not confirm the password update. Check your connection and try signing in."; }
        finally { busy = false; }
    }

    private static bool IsRequestFailure(Exception ex) => ex is HttpRequestException or OperationCanceledException or JSException or JSDisconnectedException or JsonException;

    public async ValueTask DisposeAsync()
    {
        lifetime.Cancel();
        try { if (hasLink) await JS.InvokeVoidAsync("cfcAuth.discardRecovery"); }
        catch (Exception ex) when (IsRequestFailure(ex)) { }
        lifetime.Dispose();
    }
}
