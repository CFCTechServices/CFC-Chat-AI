@page "/reset-password"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations

<div class="login-page">

    <div class="login-hero">
        <h1>@(isRecoveryMode ? "Set New Password" : "Reset Password")</h1>

        <p>
            @(isRecoveryMode
                ? "Enter your new password below."
                : "Enter your email and we'll send you a reset link.")
        </p>
    </div>

    <div class="login-card">

        @if (isRecoveryMode)
        {
            <form class="login-form"
                  @onsubmit="SetNewPassword"
                  @onsubmit:preventDefault="true">

                <h2>New Password</h2>

                <label for="new-password">New Password</label>

                <input id="new-password"
                       type="password"
                       placeholder="Enter new password"
                       autocomplete="new-password"
                       @bind="newPassword" />

                <label for="confirm-password">Confirm Password</label>

                <input id="confirm-password"
                       type="password"
                       placeholder="Confirm new password"
                       autocomplete="new-password"
                       @bind="confirmPassword" />

                @if (!string.IsNullOrEmpty(error))
                {
                    <div role="alert" style="color: #b91c1c;">
                        @error
                    </div>
                }

                <button type="submit"
                        disabled="@(string.IsNullOrEmpty(newPassword) || string.IsNullOrEmpty(confirmPassword))">
                    Set New Password
                </button>

            </form>
        }
        else
        {
            <form class="login-form"
                  @onsubmit="RequestResetEmail"
                  @onsubmit:preventDefault="true">

                <h2>Forgot Password</h2>

                <label for="reset-email">Email Address</label>

                <input id="reset-email"
                       type="email"
                       placeholder="Enter your email"
                       autocomplete="email"
                       @bind="email"
                       @bind:event="oninput" />

                @if (!string.IsNullOrWhiteSpace(email) && !IsEmailValid)
                {
                    <small role="alert" style="color: #b91c1c;">
                        Please enter a valid email address.
                    </small>
                }

                @if (!string.IsNullOrEmpty(error))
                {
                    <div role="alert" style="color: #b91c1c;">
                        @error
                    </div>
                }

                <button type="submit" disabled="@(!IsEmailValid)">
                    Send Reset Link
                </button>

                <p>
                    <a href="/login">Back to Sign In</a>
                </p>

            </form>
        }

    </div>
</div>

@code {
    private string email = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string error = string.Empty;

    // Will be enabled by a verified Supabase recovery session.
    private bool isRecoveryMode = false;

    private bool IsEmailValid =>
        !string.IsNullOrWhiteSpace(email) &&
        new EmailAddressAttribute().IsValid(email.Trim());

    private void RequestResetEmail()
    {
        error = string.Empty;

        if (!IsEmailValid)
        {
            error = "Please enter a valid email address.";
            return;
        }

        // TODO: Connect POST /api/auth/forgot-password
        error = "Password reset email service is not connected yet. No email has been sent.";
    }

    private void SetNewPassword()
    {
        error = string.Empty;

        if (newPassword.Length < 6)
        {
            error = "Password must be at least 6 characters.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            error = "Passwords do not match.";
            return;
        }

        // TODO: Verify recovery session and call Supabase auth.updateUser.
        error = "Password update service is not connected yet. No password has been changed.";
    }
}
