@page "/chat"
@rendermode InteractiveServer
@using Microsoft.JSInterop
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms
@using System.IO

 
<div class="cfc-header">
    <img src="images/logo-cfc.png"
         alt="CFC Tech Services Logo"
         class="cfc-logo"
         style="width:160px; height:auto;" />


    <div class="cfc-header-title">
        <h3>CFC Chat AI</h3>
        <p>Your Software Assistant</p>
    </div>
</div>


<div class="chat-layout">
    <div class="chat-sidebar">

        <button type="button"
                class="sidebar-new-chat"
                @onclick="StartNewChat">
            + New Chat
        </button>

        <h4>Chat History</h4>

        <div class="sidebar-history">
            @if (conversations.Count == 0)
            {
                <p>Your conversations will appear here.</p>
            }
            else
            {

                @foreach (var conversation in conversations)
                {
                    <div class="sidebar-chat-row">
                        <button type="button"
                                class="sidebar-chat-item @(activeConversation == conversation ? "active" : "")"
                                @onclick="() => SelectChat(conversation)">
                            @conversation.Title
                        </button>

                        <button type="button"
                                class="sidebar-delete-chat"
                                title="Delete chat"
                                aria-label="Delete conversation"
                                @onclick="() => DeleteChat(conversation)">
                            &#x2715;
                        </button>
                    </div>
                }

            }
        </div>
    </div>

    <div class="chat-main">
       
         <div class="chat-thread" @ref="chatThreadElement">
             
             @if (activeConversation == null ||
                activeConversation.Messages.Count == 0)
       {
            <div class="chat-empty-state">
               <h1>@welcomePhrase</h1>
               <p>
                 Ask questions about your software and
                  get quick, informed answers.
            </p>
        </div>
}



            @if (activeConversation != null)
            {

                @foreach (var message in activeConversation.Messages)
                {

                    <ChatMessage @key="message"
                                 Sender="@message.Sender"
                                 Text="@message.Text"
                                 Images="@message.Images"
                                 AnswerImages="@message.AnswerImages"
                                 AnswerVideoUrl="@message.AnswerVideoUrl"
                                 AnswerVideoTimestamps="@message.AnswerVideoTimestamps"
                                 Feedback="@message.Feedback"
                                 FeedbackChanged="(value) => SetMessageFeedback(message, value)" />

                }


                @if (activeConversation.IsThinking)
                {
                    <div class="chat-message bot"
                         role="status"
                         aria-live="polite">
                        <div class="chat-bubble cfc-thinking">
                            <span>CFC AI is thinking</span>
                            <span class="thinking-dots" aria-hidden="true">
                                <span></span>
                                <span></span>
                                <span></span>
                            </span>
                        </div>
                    </div>
                }
            }
        </div>


        
       <ChatComposer @ref="chatComposer"
                OnSend="HandleSendMessage"
                HasAttachments="@(selectedImages.Count > 0)"
                ShowLongConvoWarning="@ShowLongConvoWarning"
                OnLongConvoInfo="OpenLongConvoInfo">


            <AttachmentButton>
                <InputFile id="chat-image-upload"
                           class="chat-hidden-file-input"
                           OnChange="OnImagesSelected"
                           accept="image/png,image/jpeg,image/gif,image/webp"
                           multiple />

                
                <label for="chat-image-upload"
                       class="chat-attach-button"
                       title="Attach images (up to 4)">
                    <svg width="18" height="18"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M21.44 11.05 12.25 20.24a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.82-2.82l8.49-8.48" />
                    </svg>
                    Attach
                </label>

            </AttachmentButton>

        </ChatComposer>

        @if (!string.IsNullOrWhiteSpace(imageError) ||
             selectedImages.Count > 0)
        {
            <div class="chat-attachment-picker">

                @if (!string.IsNullOrWhiteSpace(imageError))
                {
                    <small role="alert" style="color: #b91c1c;">
                        @imageError
                    </small>
                }

                @if (selectedImages.Count > 0)
                {
                    <div class="chat-upload-previews">
                        @foreach (var image in selectedImages)
                        {
                            <div class="chat-upload-preview" @key="image.Id">
                                <img src="@image.DataUrl"
                                     alt="@image.Name" />

                                <button type="button"
                                        title="Remove image"
                                        aria-label="Remove image"
                                        @onclick="() => RemoveSelectedImage(image)">
                                    ✕
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        }


    </div>
</div>
     
@if (showLongConvoInfo)
{
    <div class="cfc-long-convo-overlay"
         @onclick="CloseLongConvoInfo">

        <div class="cfc-long-convo-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="long-convo-title"
             @onclick:stopPropagation="true">

            <button type="button"
                    class="cfc-long-convo-close"
                    aria-label="Close notice"
                    @onclick="CloseLongConvoInfo">
                ✕
            </button>

            <h3 id="long-convo-title">
                Long Conversation Notice
            </h3>

            <p>
                This conversation is getting long.
                CFC AI may begin to lose sight of the
                original goal in very long conversations.
            </p>

            <p>
                For separate questions or new topics,
                consider starting a new chat to keep
                responses focused.
            </p>
        </div>
    </div>
}


@code {
    private List<Conversation> conversations = new();
    private Conversation? activeConversation;
    private ChatComposer? chatComposer;

    private const int MaxImages = 4;
    private const long MaxImageBytes = 2 * 1024 * 1024;

    private List<SelectedImage> selectedImages = new();
    private string imageError = "";

    private sealed class SelectedImage
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string Name { get; set; } = "";
        public string DataUrl { get; set; } = "";
    }

    private async Task OnImagesSelected(InputFileChangeEventArgs e)
    {
        imageError = "";

        IReadOnlyList<IBrowserFile> files;

        try
        {
            files = e.GetMultipleFiles(MaxImages);
        }
        catch (InvalidOperationException)
        {
            imageError = "Select no more than 4 images at once.";
            return;
        }

        foreach (var file in files)
        {
            if (selectedImages.Count >= MaxImages)
            {
                imageError = "You can attach up to 4 images.";
                break;
            }

            string[] allowedTypes =
            {
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp"
        };

            if (!allowedTypes.Contains(
                file.ContentType,
                StringComparer.OrdinalIgnoreCase))
            {
                imageError = "Please select a supported image file.";
                continue;
            }

            if (file.Size > MaxImageBytes)
            {
                imageError = "Each image must be 2 MB or smaller.";
                continue;
            }

            try
            {
                await using var stream =
                    file.OpenReadStream(MaxImageBytes);

                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);

                selectedImages.Add(new SelectedImage
                {
                    Name = file.Name,
                    DataUrl = $"data:{file.ContentType};base64," +
                        Convert.ToBase64String(memory.ToArray())
                });
            }
            catch (IOException)
            {
                imageError = "Could not read the selected image.";
            }
        }
    }

    private void RemoveSelectedImage(SelectedImage image)
    {
        selectedImages.Remove(image);
    }



    private Conversation CreateConversation()
    {
        var conversation = new Conversation();
        conversations.Insert(0, conversation);
        activeConversation = conversation;
        welcomePhrase = PickWelcomePhrase();
        showLongConvoInfo = false;
        return conversation;
    }


    
    private async Task StartNewChat()
    {
        CreateConversation();

        selectedImages.Clear();
        imageError = "";

        if (chatComposer is not null)
        {
            await chatComposer.FocusInputAsync();
        }
    }


    
    private void SelectChat(Conversation conversation)
    {
        activeConversation = conversation;
        welcomePhrase = PickWelcomePhrase();
        showLongConvoInfo = false;

        selectedImages.Clear();
        imageError = "";

        shouldScrollToBottom = true;
    }



    private async Task DeleteChat(Conversation conversation)
    {
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to delete '{conversation.Title}'?"
        );

        if (!confirmed)
            return;

        bool wasActive = activeConversation == conversation;

        conversations.Remove(conversation);

        if (wasActive)
        {
            activeConversation = conversations.FirstOrDefault();
            shouldScrollToBottom = true;
        }
    }


  
    private async Task HandleSendMessage(string message)
      {
       if (string.IsNullOrWhiteSpace(message) &&
        selectedImages.Count == 0)
        return;

        var conversation = activeConversation ?? CreateConversation();

        if (conversation.IsThinking)
            return;

        if (conversation.Messages.Count == 0)
        {
           string title = string.IsNullOrWhiteSpace(message)
             ? "Image attachment"
             : message.Trim();

           conversation.Title = title.Length > 30
                ? title[..30] + "..."
                : title;
        }

        // Display the user's message
        conversation.Messages.Add(new ChatEntry
        {
            Sender = "You",
            Text = message,
            Images = selectedImages.Select(i => i.DataUrl).ToList()
        });

        selectedImages.Clear();
        imageError = "";

        // Show the thinking indicator
        conversation.IsThinking = true;
        shouldScrollToBottom = true;

        StateHasChanged();

        // Simulated delay until the real API is available
        await Task.Delay(1500);

        // The conversation might have been deleted
        if (!conversations.Contains(conversation))
            return;

        // Hide the indicator
        conversation.IsThinking = false;

        // Temporary AI response
        conversation.Messages.Add(new ChatEntry
        {
            Sender = "CFC AI",
            Text = "Hello! I received your message."
        });

        if (activeConversation == conversation)
            shouldScrollToBottom = true;
    }



    private class Conversation
    {
        public string Title { get; set; } = "New Chat";
        public List<ChatEntry> Messages { get; set; } = new();
        public bool IsThinking { get; set; } = false;
    }

    
    
    private class ChatEntry
    {
        public string Sender { get; set; } = "";
        public string Text { get; set; } = "";
        public string? Feedback { get; set; }
        public List<string> Images { get; set; } = new();

        // Images and videos returned by CFC AI
        public List<string> AnswerImages { get; set; } = new();
        public string? AnswerVideoUrl { get; set; }
        public List<(double Seconds, string Label)> AnswerVideoTimestamps
        { get; set; } = new();
    }


    
    private void SetMessageFeedback(ChatEntry message, string? feedback)
    {
        message.Feedback = feedback;
    }



    private ElementReference chatThreadElement;
    private bool shouldScrollToBottom = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldScrollToBottom)
        {
            shouldScrollToBottom = false;

            await JS.InvokeVoidAsync(
                "cfcChat.scrollToBottom",
                chatThreadElement
            );
        }
    }
    
    private static readonly string[] WelcomePhrases =
    {
    "Chat with CFC AI",
    "What can CFC AI help with today?",
    "Ready when you are",
    "Ask anything about CFC software…",
    "How can I help you today?"
     };

     private string welcomePhrase = PickWelcomePhrase();

     private static string PickWelcomePhrase()
    {
       return WelcomePhrases[
         Random.Shared.Next(WelcomePhrases.Length)];
     }

     private bool showLongConvoInfo = false;

     private bool ShowLongConvoWarning =>
      activeConversation?.Messages.Count > 12;

     private void OpenLongConvoInfo()
     {
       showLongConvoInfo = true;
      }

     private void CloseLongConvoInfo()
     {
    showLongConvoInfo = false;
     }


 }
