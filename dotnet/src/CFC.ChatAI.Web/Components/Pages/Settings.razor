@page "/settings"
@using CFC.ChatAI.Web.Models
@using CFC.ChatAI.Web.Services
@inject SupabaseSessionService Session
@implements IDisposable

<PageTitle>Settings | CFC Chat AI</PageTitle>
@if (Profile is { } account)
{
    <section class="settings" aria-labelledby="settings-title">
        <h1 id="settings-title">Settings</h1>
        <form class="settings-card" aria-labelledby="profile-heading" @onsubmit="SaveProfileAsync" @onsubmit:preventDefault>
            <h2 id="profile-heading">Profile</h2>
            <fieldset disabled="@busy" aria-labelledby="profile-heading">
                <dl class="account-details">
                    <dt>Email address</dt><dd>@account.Email</dd>
                    <dt>Account role</dt><dd>@account.Role</dd>
                </dl>
                <div class="field-row">
                    <label for="settings-name">Full name</label>
                    <input id="settings-name" type="text" autocomplete="name" @bind="name" @bind:event="oninput" />
                </div>
                <div class="field-row">
                    <label for="settings-avatar">Profile image</label>
                    <div class="avatar-row">
                        @if (AvatarUrl is { } url && url != failedImage)
                        {
                            <img @key="url" src="@url" alt="Profile avatar" width="44" height="44" referrerpolicy="no-referrer"
                                 @onerror="() => ImageFailed(url)" />
                        }
                        <div class="field-stack">
                            <InputFile @key="fileVersion" id="settings-avatar" accept="@ProfileAvatar.AcceptedTypes"
                                       aria-describedby="avatar-help" OnChange="SelectAvatarAsync" />
                            <small id="avatar-help">PNG, JPEG, WebP or GIF, up to 512 KiB.</small>
                        </div>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" disabled="@(!HasProfileChange || invalidFile)">Save profile</button>
                    @if (avatar is not null || invalidFile)
                    {
                        <button type="button" class="secondary" @onclick="DiscardAvatar">Discard image selection</button>
                    }
                </div>
            </fieldset>
            @if (profileResult is { } result)
            {
                <p role="@(result.Success ? "status" : "alert")">@result.Message</p>
            }
        </form>
        <form class="settings-card" aria-labelledby="security-heading" @onsubmit="ChangePasswordAsync" @onsubmit:preventDefault>
            <h2 id="security-heading">Security</h2>
            <fieldset disabled="@busy" aria-labelledby="security-heading">
                <div class="field-row">
                    <label for="settings-password">New password</label>
                    <div class="field-stack">
                        <div class="password-row">
                            <input id="settings-password" type="@(showNew ? "text" : "password")" autocomplete="new-password" required minlength="6"
                                   aria-describedby="password-help" @ref="password" />
                            <button type="button" class="secondary" aria-controls="settings-password" @onclick="() => showNew = !showNew">@(showNew ? "Hide" : "Show") new password</button>
                        </div>
                        <meter id="settings-strength" aria-label="New password strength" min="0" max="100" low="60" high="80" optimum="100" value="0"></meter>
                        <small id="password-help">Use at least 6 characters. A longer password or a mix of character types improves strength.</small>
                    </div>
                </div>
                <div class="field-row">
                    <label for="settings-confirmation">Confirm password</label>
                    <div class="password-row">
                        <input id="settings-confirmation" type="@(showConfirmation ? "text" : "password")" autocomplete="new-password" required @ref="confirmation" />
                        <button type="button" class="secondary" aria-controls="settings-confirmation" @onclick="() => showConfirmation = !showConfirmation">@(showConfirmation ? "Hide" : "Show") confirmation</button>
                    </div>
                </div>
                <div class="form-actions"><button type="submit">Update password</button></div>
            </fieldset>
            @if (passwordResult is { } outcome)
            {
                <p role="@(outcome.Success ? "status" : "alert")">@outcome.Message</p>
            }
        </form>
        <section class="settings-card preference-card" aria-labelledby="preferences-heading">
            <h2 id="preferences-heading">Appearance &amp; Preferences</h2>
            <cfc-preferences>
                <div class="field-row">
                    <label for="theme">Theme</label>
                    <select id="theme" data-preference="theme"><option value="light">Light</option><option value="dark">Dark</option></select>
                </div>
                <div class="field-row">
                    <label for="text-size">Text size</label>
                    <select id="text-size" data-preference="text-size">
                        <option value="small">Small</option><option value="medium">Medium</option><option value="large">Large</option>
                    </select>
                </div>
                <div class="field-row">
                    <label for="starting-page">Starting page</label>
                    <select id="starting-page" data-preference="starting-page">
                        <option value="auto">Account default</option>
                        @foreach (var destination in AppDestination.StartingPages(account))
                        {
                            <option value="@(destination.Path[1..])">@destination.Label</option>
                        }
                    </select>
                </div>
                <small>Changes apply immediately in this browser.</small>
                <small data-storage-notice hidden role="status">Browser storage is unavailable. Preferences apply for this visit.</small>
            </cfc-preferences>
        </section>
    </section>
}

@code {
    [CascadingParameter] public ProfileResponse? Profile { get; set; }
    private readonly CancellationTokenSource lifetime = new();
    private string name = "";
    private string savedName = "";
    private ProfileAvatar? avatar;
    private string? failedImage;
    private int fileVersion;
    private bool busy;
    private bool invalidFile;
    private bool showNew, showConfirmation;
    private SettingsResult? profileResult, passwordResult;
    private ElementReference password, confirmation;

    private string? AvatarUrl => avatar?.DataUrl ?? ProfileAvatar.DisplayUrl(Profile?.AvatarUrl);
    private bool HasProfileChange => name != savedName || avatar is not null;

    protected override void OnParametersSet()
    {
        var latestName = Profile?.FullName ?? "";
        if (name == savedName) name = latestName;
        savedName = latestName;
    }

    private async Task SelectAvatarAsync(InputFileChangeEventArgs args)
    {
        if (busy || Profile is null) return;
        busy = true;
        profileResult = null;
        avatar = null;
        invalidFile = true;
        try
        {
            avatar = await ProfileAvatar.ReadAsync(args.File, lifetime.Token);
            failedImage = null;
            invalidFile = false;
        }
        catch (InvalidDataException ex) { profileResult = new(false, ex.Message); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) when (ex is IOException or JSException or OperationCanceledException)
        {
            profileResult = new(false, "Could not read the image. Select the file again.");
        }
        finally { busy = false; }
    }

    private void DiscardAvatar()
    {
        fileVersion++;
        avatar = null;
        invalidFile = false;
        profileResult = null;
    }

    private void ImageFailed(string url)
    {
        if (AvatarUrl != url) return;
        failedImage = url;
        if (avatar is null) return;
        invalidFile = true;
        profileResult = new(false, "Your browser could not display this image. Choose another file.");
    }

    private async Task SaveProfileAsync()
    {
        if (busy || invalidFile || Profile is null || !HasProfileChange) return;
        var owner = Profile.Id;
        busy = true;
        profileResult = null;
        try
        {
            var result = await Session.SaveProfileAsync(owner, name == savedName ? null : name, avatar, lifetime.Token);
            if (lifetime.IsCancellationRequested) return;
            if (result.Success)
            {
                if (Session.State.Profile is not { } saved || saved.Id != owner) return;
                DiscardAvatar();
                name = savedName = saved.FullName ?? "";
            }
            profileResult = result;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        finally { busy = false; }
    }

    private async Task ChangePasswordAsync()
    {
        if (busy || Profile is null) return;
        busy = true;
        passwordResult = null;
        showNew = showConfirmation = false;
        try { passwordResult = await Session.ChangePasswordAsync(Profile.Id, password, confirmation, lifetime.Token); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        finally { busy = false; }
    }

    public void Dispose()
    {
        lifetime.Cancel();
        lifetime.Dispose();
    }
}
