@using CFC.ChatAI.Web.Services
@inject FastApiClient Api
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Developer Docs | CFC Chat AI</PageTitle>
<section class="developer-docs" aria-labelledby="docs-title">
    <h1 id="docs-title">Developer workspace</h1>
    <h2>Interactive API documentation</h2>
    @if (Address is { } url)
    {
        <p><a href="@url" target="_blank" rel="noopener noreferrer">Open Swagger in a new tab</a></p>
        @if (checking) { <p role="status">Checking API documentation…</p> }
        else if (embed)
        {
            <p>If your browser blocks the embedded documentation, use the link above.</p>
            <iframe src="@url" title="FastAPI interactive API documentation" referrerpolicy="no-referrer"></iframe>
        }
        else
        {
            <p role="status">The documentation is unavailable or this deployment restricts embedding.</p>
            <button type="button" @onclick="CheckAsync">Retry documentation</button>
        }
    }
    else { <p role="status">Configure FastApi:BaseUrl to point to the backend documentation host.</p> }
    <h2>Implementation notes</h2>
    <ul>
        <li>Search and chat retrieve indexed content to ground assistant answers.</li>
        <li>Python transcribes videos with Whisper and indexes transcript chunks in Pinecone.</li>
        <li>Document uploads trigger ingestion. Blazor enables submission only for approved, admin-protected deployments.</li>
    </ul>
</section>

@code {
    private readonly CancellationTokenSource lifetime = new();
    private Uri PageUri => new(Navigation.Uri);
    private Uri? Address => Api.DocsAddress is { } url && url.GetLeftPart(UriPartial.Path).TrimEnd('/') !=
        PageUri.GetLeftPart(UriPartial.Path).TrimEnd('/') ? url : null;
    private bool checking = true, embed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Address is not null) { await CheckAsync(); if (!lifetime.IsCancellationRequested) StateHasChanged(); }
    }
    private async Task CheckAsync()
    {
        checking = true;
        try { embed = await Api.CanEmbedDocsAsync(PageUri, lifetime.Token); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        finally { checking = false; }
    }
    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
