@page "/history"
@using CFC.ChatAI.Web.Models
@using CFC.ChatAI.Web.Services
@inject FastApiClient Api
@inject SupabaseSessionService Session
@inject TimeProvider Clock
@implements IDisposable

<PageTitle>Chat History | CFC Chat AI</PageTitle>
<section class="history" aria-labelledby="history-title">
    <h1 id="history-title">Chat History</h1>
    <div class="history-tools">
        <label class="search">
            Search conversations
            <input type="search" placeholder="Search titles or previews" @bind="query" @bind:event="oninput" />
        </label>
        <label>
            Creation date
            <select @bind="days">
                <option value="0">All</option>
                <option value="1">Last 24 Hours</option>
                <option value="7">Last 7 Days</option>
                <option value="30">Last 30 Days</option>
            </select>
        </label>
        <button type="button" disabled="@loading" @onclick="LoadAsync">Refresh</button>
    </div>

    @if (loading)
    {
        <p role="status">Loading conversations…</p>
    }
    else if (workspace.Notice is not null)
    {
        <p role="alert">@workspace.Notice Use Refresh to try again.</p>
    }
    else if (sessions.Count == 0)
    {
        <p role="status">You have no saved conversations.</p>
    }
    else
    {
        var now = Clock.GetUtcNow();
        var matches = ConversationHistory.Filter(sessions, query, days, now);
        @if (matches.Count == 0)
        {
            <p role="status">No conversations match your filters.</p>
        }
        else
        {
            <ul class="history-list">
                @foreach (var row in matches)
                {
                    <li @key="row.Id">
                        <a class="history-item" href="@Chat.PathForSession(row.Id)">
                            <strong>@ConversationHistory.Title(row)</strong>
                            <span>@(string.IsNullOrWhiteSpace(row.LastMessage) ? "No preview available" : row.LastMessage)</span>
                            <small>
                                @if (ConversationHistory.CreatedAt(row) is { } created)
                                {
                                    <time datetime="@created.ToString("O")">Created @ConversationHistory.CreationLabel(created, now)</time>
                                }
                                else
                                {
                                    <span>Creation date unavailable</span>
                                }
                                <span>@(row.MessageCount switch { 1 => "1 message", >= 0 => $"{row.MessageCount} messages", _ => "Message count unavailable" })</span>
                            </small>
                        </a>
                    </li>
                }
            </ul>
        }
    }
</section>

@code {
    private ChatWorkspace workspace = default!;
    private IReadOnlyList<ChatSession> sessions = [];
    private bool loading;
    private string query = "";
    private int days;

    protected override Task OnInitializedAsync()
    {
        workspace = new ChatWorkspace(Api, Session, Session.State.Profile!.Id);
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (loading) return;
        loading = true;
        try { sessions = await workspace.GetOwnedSessionsAsync(detail: true) ?? []; }
        finally { loading = false; }
    }

    public void Dispose() => workspace.Dispose();
}
