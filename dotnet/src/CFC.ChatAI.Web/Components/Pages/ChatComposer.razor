
<div class="chat-composer">
    
  @if (ShowLongConvoWarning)
   {
     <button type="button"
            class="composer-info-icon"
            title="Conversation length info"
            aria-label="Conversation length information"
            @onclick="() => OnLongConvoInfo.InvokeAsync()">
        ⓘ
      </button>
     }
  
        <input type="text"
           @ref="messageInput"
           placeholder="Ask a question about CFC software..."
           @bind="message"
           @bind:event="oninput"
           @onkeydown="HandleKeyDown" />

      @AttachmentButton

      <button type="button" @onclick="SendMessageAsync">
         Send
     </button>
</div>

@code {
    private string message = "";

    [Parameter]
    public EventCallback<string> OnSend { get; set; }

    [Parameter]
    public RenderFragment? AttachmentButton { get; set; }

    [Parameter]
    public bool HasAttachments { get; set; }

    
    [Parameter]
    public bool ShowLongConvoWarning { get; set; }

    [Parameter]
    public EventCallback OnLongConvoInfo { get; set; }


   
    private async Task SendMessageAsync()
     {
    // Allow sending if there is text OR an attachment
       if (string.IsNullOrWhiteSpace(message) && !HasAttachments)
         return;

       string text = message;
       message = "";

       await OnSend.InvokeAsync(text);
     }


    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessageAsync();
        }
    }

    private ElementReference messageInput;

    public async Task FocusInputAsync()
    {
        await messageInput.FocusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FocusInputAsync();
        }
    }
}
