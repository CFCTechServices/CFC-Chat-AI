<?xml version="1.0" encoding="utf-8"?>
<!-- Staged as site/web.config by Publish-DotnetIis.ps1. Requires IIS URL Rewrite, ARR and ASP.NET Core Module V2. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <httpErrors existingResponse="PassThrough" />
      <security>
        <requestFiltering allowDoubleEscaping="false">
          <requestLimits maxAllowedContentLength="53477376" />
        </requestFiltering>
      </security>
      <rewrite>
        <rules>
          <clear />
          <rule name="Block development ingest" stopProcessing="true">
            <match url="^api/ingest/dev(?:/|$)" />
            <action type="CustomResponse" statusCode="404" statusReason="Not Found" />
          </rule>
          <!-- These are the only public API method/path pairs. Blazor itself calls the API over loopback. -->
          <rule name="API GET" stopProcessing="true">
            <match url="^(?:api/health|api/auth/config|api/profile/me|api/chat/sessions(?:/[^/]+)?|api/chat/feedback|(?:api/chat/)?content/images/docs/[^/]+/images/[^/]+|api/admin/(?:documents(?:/[^/]+/download)?|users|settings))/?$" />
            <conditions><add input="{REQUEST_METHOD}" pattern="^GET$" /></conditions>
            <action type="Rewrite" url="http://127.0.0.1:5000/{R:0}" appendQueryString="true" />
          </rule>
          <rule name="API POST" stopProcessing="true">
            <match url="^(?:api/auth/(?:check-email|forgot-password)|api/chat/(?:sessions|feedback|message)|api/files/upload|api/admin/(?:invite|change-role|users/[^/]+/(?:deactivate|reactivate)))/?$" />
            <conditions><add input="{REQUEST_METHOD}" pattern="^POST$" /></conditions>
            <action type="Rewrite" url="http://127.0.0.1:5000/{R:0}" appendQueryString="true" />
          </rule>
          <rule name="API PATCH" stopProcessing="true">
            <match url="^(?:api/profile/me|api/chat/sessions/[^/]+|api/admin/settings)/?$" />
            <conditions><add input="{REQUEST_METHOD}" pattern="^PATCH$" /></conditions>
            <action type="Rewrite" url="http://127.0.0.1:5000/{R:0}" appendQueryString="true" />
          </rule>
          <rule name="API PUT" stopProcessing="true">
            <match url="^api/admin/documents/[^/]+/replace/?$" />
            <conditions><add input="{REQUEST_METHOD}" pattern="^PUT$" /></conditions>
            <action type="Rewrite" url="http://127.0.0.1:5000/{R:0}" appendQueryString="true" />
          </rule>
          <rule name="API DELETE" stopProcessing="true">
            <match url="^(?:api/chat/sessions/[^/]+|api/admin/(?:documents|users)/[^/]+)/?$" />
            <conditions><add input="{REQUEST_METHOD}" pattern="^DELETE$" /></conditions>
            <action type="Rewrite" url="http://127.0.0.1:5000/{R:0}" appendQueryString="true" />
          </rule>
          <rule name="Block other API requests" stopProcessing="true">
            <match url="^(?:api|content/images)(?:/|$)" />
            <action type="CustomResponse" statusCode="404" statusReason="Not Found" />
          </rule>
          <!-- Page routes, static assets and the /_blazor SignalR hub fall through to ANCM. -->
        </rules>
      </rewrite>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\CFC.ChatAI.Web.exe" hostingModel="inprocess" stdoutLogEnabled="false" />
    </system.webServer>
  </location>
</configuration>
