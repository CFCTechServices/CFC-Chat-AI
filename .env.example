# CFC Chat AI (.NET API). Copy to .env if needed; never commit real credentials.
# Blank provider settings allow a liveness-only start. Environment variables win.

# API: use loopback for local development and IIS/NSSM.
DOTNET_API_PORT=5000
# Api__Urls=http://127.0.0.1:5000

# Supabase: set all three to enable Auth, database, and Storage routes.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENTS_BUCKET=cfc-docs
SUPABASE_VIDEOS_BUCKET=cfc-videos
# Use the full Blazor recovery URL, and allow it in Supabase Auth.
PASSWORD_RESET_REDIRECT_URL=http://localhost:5077/reset-password

# Pinecone and the matching ONNX model enable RAG and document mutations.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=
# Use absolute paths to model.onnx and vocab.txt (see docs/rag/embeddings.md).
Embedding__ModelPath=
Embedding__VocabularyPath=

# Optional generation. Set all three or leave all three empty for extractive answers.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Optional document processing/staging. Use existing private operator-owned directories.
# Document__LibreOfficePath=C:/Program Files/LibreOffice/program/soffice.com
# Document__StagingRoot=C:/local/documents
# Document__ProcessedRoot=C:/local/processed
# Document__MaxUploadBytes=52428800
# Api__AdminSettingsPath=C:/local/private/admin.json

# Keep development endpoints off on shared/deployed hosts. Profile and account changes
# require the gates in docs/plan/internal-api-cutover.md before enabling them.
Api__EnableDevIngest=false
Api__EnableDevDelete=false
Api__EnableProfileWrites=false
Api__EnableAccountLifecycle=false
Api__EnablePermanentAccountDeletion=false
# Api__AccountLifecycleJournalDirectory=C:/local/private/account-journal
