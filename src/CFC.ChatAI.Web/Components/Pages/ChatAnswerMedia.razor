
@using Microsoft.JSInterop
@using System.Text.Json
@using CFC.ChatAI.Web.Models
@inject IJSRuntime JS
@inject ChatApiClient Api
@inject SupabaseSessionService Session
@implements IDisposable

@if (Image is not null || !string.IsNullOrWhiteSpace(VideoUrl))
{
    <div class="chat-answer-media">

        @if (imageFailed)
        {
            <small>Image unavailable (@Image?.AltText)</small>
        }
        else if (Image is not null)
        {
            @if (displayUrl is { } url)
            {
                <button type="button" class="chat-answer-image-button" title="Enlarge image"
                        @onclick="() => imagePreview = true">
                    <img @key="url" src="@url" alt="@Image.AltText" referrerpolicy="no-referrer"
                         @onerror="() => ImageUnavailableAsync(url)" loading="lazy" />
                </button>
            }
            else
            {
                <small role="status">Loading image…</small>
            }
        }

        @if (!string.IsNullOrWhiteSpace(VideoUrl))
        {
            <div class="chat-answer-video">

                <video @ref="videoElement"
                       src="@VideoUrl"
                       class="chat-response-video"
                       controls
                       preload="metadata">
                </video>

                @if (VideoTimestamps.Count > 0)
                {
                    <div class="chat-video-timestamps">
                        @foreach (var moment in VideoTimestamps)
                        {
                            <button type="button"
                                    @onclick="() => SeekTo(moment.Seconds)">
                                @moment.Label
                            </button>
                        }
                    </div>
                }

                <button type="button"
                        class="chat-expand-video"
                        @onclick="() => videoExpanded = true">
                    Expand video
                </button>
            </div>
        }
    </div>
}

@if (imagePreview && Image is not null && displayUrl is { } previewUrl)
{
    <div class="cfc-media-backdrop"
         @onclick="CloseImage">
        <div class="cfc-media-modal"
             role="dialog"
             aria-modal="true"
             aria-label="Image preview"
             @onclick:stopPropagation="true">

            <button type="button"
                    class="cfc-media-close"
                    aria-label="Close image preview"
                    @onclick="CloseImage">
                ✕
            </button>

            <img src="@previewUrl" alt="@Image.AltText" referrerpolicy="no-referrer" @onerror="() => ImageUnavailableAsync(previewUrl)" />
        </div>
    </div>
}

@if (videoExpanded && !string.IsNullOrWhiteSpace(VideoUrl))
{
    <div class="cfc-media-backdrop"
         @onclick="CloseVideo">
        <div class="cfc-media-modal"
             role="dialog"
             aria-modal="true"
             aria-label="Video preview"
             @onclick:stopPropagation="true">

            <button type="button"
                    class="cfc-media-close"
                    @onclick="CloseVideo">
                ✕
            </button>

            <video src="@VideoUrl"
                   controls
                   autoplay>
            </video>
        </div>
    </div>
}

@code {
    [CascadingParameter] public ProfileResponse? Profile { get; set; }

    [Parameter]
    public AnswerImage? Image { get; set; }

    [Parameter]
    public string? VideoUrl { get; set; }

    [Parameter]
    public IReadOnlyList<(double Seconds, string Label)> VideoTimestamps
        { get; set; } =
        Array.Empty<(double Seconds, string Label)>();

    private bool imagePreview;
    private bool imageFailed;
    private bool retried;
    private Uri? previousUrl;
    private string? previousOwner;
    private string? displayUrl;
    private CancellationTokenSource? lookup;
    private bool videoExpanded;
    private ElementReference videoElement;

    protected override Task OnParametersSetAsync()
    {
        var url = Image?.Url;
        var owner = Profile?.Id;
        if (previousUrl == url && previousOwner == owner) return Task.CompletedTask;
        CancelLookup();
        previousUrl = url;
        previousOwner = owner;
        imagePreview = imageFailed = retried = false;
        displayUrl = url is { IsAbsoluteUri: true } ? url.AbsoluteUri : null;
        return url is { IsAbsoluteUri: false } ? ResolveAsync(url, owner) : Task.CompletedTask;
    }

    private async Task ResolveAsync(Uri route, string? owner)
    {
        if (owner is null) { imageFailed = true; return; }
        using var pending = new CancellationTokenSource();
        lookup = pending;
        try
        {
            var signed = await Session.WithAccessTokenAsync(owner, (token, ct) => Api.ResolveImageAsync(token, route, ct), pending.Token);
            if (lookup != pending) return;
            displayUrl = signed?.AbsoluteUri;
            imageFailed = displayUrl is null;
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or OperationCanceledException)
        {
            if (lookup == pending) imageFailed = true;
        }
        finally { if (lookup == pending) lookup = null; }
    }

    private void CloseImage() => imagePreview = false;

    private Task ImageUnavailableAsync(string url)
    {
        if (displayUrl != url) return Task.CompletedTask;
        displayUrl = null;
        CloseImage();
        if (!retried && previousUrl is { IsAbsoluteUri: false } route)
        {
            retried = true;
            return ResolveAsync(route, previousOwner);
        }
        imageFailed = true;
        return Task.CompletedTask;
    }

    private void CancelLookup()
    {
        var pending = lookup;
        lookup = null;
        pending?.Cancel();
    }

    public void Dispose() => CancelLookup();

    private void CloseVideo()
    {
        videoExpanded = false;
    }

    private async Task SeekTo(double seconds)
    {
        await JS.InvokeVoidAsync(
            "cfcChat.seekVideo",
            videoElement,
            seconds);
    }
}

